# Live tests of the SDK against the real OVHcloud API: composer test:live (see docs/testing.md).
# Copy this file to .env, which git ignores. A variable of the environment takes precedence over the file.

OVH_REGION=eu
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=

# Read only consumer key, restricted to the domain below: request it with php tests/Live/consumer-key.php.
# The live tests refuse to run with a key that can write or read the transfer code of the domain.
OVH_CONSUMER_KEY=

# Domain, and DNS zone of the same name, that the live tests read.
OVH_LIVE_DOMAIN=
