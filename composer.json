{
    "name": "forxer/ovh-sdk",
    "description": "An unofficial, modern PHP SDK for the OVHcloud API, built on Saloon, with Laravel integration.",
    "homepage": "https://github.com/forxer/ovh-sdk",
    "keywords": [
        "ovh",
        "ovhcloud",
        "api",
        "sdk",
        "saloon",
        "laravel"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vincent Garnier",
            "email": "forxer@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/forxer/ovh-sdk/issues",
        "email": "forxer@gmail.com"
    },
    "require": {
        "php": "^8.4",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0",
        "saloonphp/saloon": "^4.5"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "phpstan/phpstan": "^2.3",
        "rector/rector": "^2.7",
        "vlucas/phpdotenv": "^5.6"
    },
    "conflict": {
        "laravel/framework": "<13.0"
    },
    "suggest": {
        "laravel/framework": "Laravel 13 integration (service provider, facade, artisan command)"
    },
    "autoload": {
        "psr-4": {
            "OvhSdk\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "OvhSdk\\Laravel\\OvhSdkServiceProvider"
            ],
            "aliases": {
                "Ovh": "OvhSdk\\Laravel\\Facades\\Ovh"
            }
        }
    },
    "scripts": {
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse",
        "refactor": "rector",
        "test": "pest",
        "test:live": "pest --testsuite=Live",
        "check": ["@lint", "@analyse", "@test"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
